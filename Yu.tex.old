    numbers=left,        % 行号在左侧
    numberstyle=\tiny,    % 行号字体大小
    frame=single,         % 单边框
    breaklines=true,      % 自动换行
    keywordstyle=\color{blue},    % 关键字颜色
    stringstyle=\color{red},      % 字符串颜色
    commentstyle=\color{green!60},% 注释颜色
    showspaces=false,      % 不显示空格
    showstringspaces=false
}

